{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "gramdoc",
  "rules": {
    "document": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "/**"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "name"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "description"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_tag"
          }
        },
        {
          "type": "STRING",
          "value": "*/"
        }
      ]
    },
    "description": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "description_line"
      }
    },
    "description_line": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "[^@\\s*]"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "([^\\n*]|\\*[^\\/\\n])*"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "_tag": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "property_tag"
        },
        {
          "type": "SYMBOL",
          "name": "alias_tag"
        },
        {
          "type": "SYMBOL",
          "name": "reference_tag"
        },
        {
          "type": "SYMBOL",
          "name": "unknown_tag"
        }
      ]
    },
    "property_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@property"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "description",
              "content": {
                "type": "SYMBOL",
                "name": "tag_description"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "alias_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@alias"
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "alias"
          }
        }
      ]
    },
    "reference_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@reference"
        },
        {
          "type": "FIELD",
          "name": "target",
          "content": {
            "type": "SYMBOL",
            "name": "reference_target"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "description",
              "content": {
                "type": "SYMBOL",
                "name": "tag_description"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "unknown_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "tag_name"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "description",
              "content": {
                "type": "SYMBOL",
                "name": "tag_description"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "tag_description": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "description_line"
      }
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "alias": {
      "type": "PATTERN",
      "value": "[^\\s*]([^\\n*]|\\*[^\\/\\n])*"
    },
    "reference_target": {
      "type": "PATTERN",
      "value": "[^\\s*]\\S*"
    },
    "tag_name": {
      "type": "PATTERN",
      "value": "@[a-zA-Z_][a-zA-Z0-9_-]*"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s+"
    },
    {
      "type": "PATTERN",
      "value": "[ \\t]*\\*[ \\t\\n]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "name"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}