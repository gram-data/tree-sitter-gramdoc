{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "gramdoc",
  "rules": {
    "document": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "/**"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "name"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "description"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_tag"
          }
        },
        {
          "type": "STRING",
          "value": "*/"
        }
      ]
    },
    "description": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "description_line"
      }
    },
    "description_line": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "PATTERN",
            "value": "[^@\\s*]"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "([^\\n*]|\\*[^\\/\\n])*"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "_tag": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "property_tag"
        },
        {
          "type": "SYMBOL",
          "name": "label_tag"
        },
        {
          "type": "SYMBOL",
          "name": "alias_tag"
        },
        {
          "type": "SYMBOL",
          "name": "elements_tag"
        },
        {
          "type": "SYMBOL",
          "name": "element_tag"
        },
        {
          "type": "SYMBOL",
          "name": "language_tag"
        },
        {
          "type": "SYMBOL",
          "name": "reference_tag"
        },
        {
          "type": "SYMBOL",
          "name": "unknown_tag"
        }
      ]
    },
    "property_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@property"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "FIELD",
                  "name": "term",
                  "content": {
                    "type": "SYMBOL",
                    "name": "term"
                  }
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "_colon"
                    },
                    {
                      "type": "BLANK"
                    }
                  ]
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "description",
              "content": {
                "type": "ALIAS",
                "content": {
                  "type": "SYMBOL",
                  "name": "_property_description"
                },
                "named": true,
                "value": "tag_description"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "FIELD",
            "name": "attribute",
            "content": {
              "type": "SYMBOL",
              "name": "attribute"
            }
          }
        }
      ]
    },
    "attribute": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_attribute_open"
        },
        {
          "type": "FIELD",
          "name": "key",
          "content": {
            "type": "SYMBOL",
            "name": "attribute_key"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "value",
              "content": {
                "type": "SYMBOL",
                "name": "attribute_value"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "attribute_key": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_-]*"
    },
    "_property_description": {
      "type": "REPEAT1",
      "content": {
        "type": "ALIAS",
        "content": {
          "type": "SYMBOL",
          "name": "_property_line"
        },
        "named": true,
        "value": "description_line"
      }
    },
    "label_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@label"
        },
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "identifier"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "description",
              "content": {
                "type": "SYMBOL",
                "name": "tag_description"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "alias_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@alias"
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "alias"
          }
        }
      ]
    },
    "reference_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@reference"
        },
        {
          "type": "FIELD",
          "name": "target",
          "content": {
            "type": "SYMBOL",
            "name": "reference_target"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "description",
              "content": {
                "type": "SYMBOL",
                "name": "tag_description"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "elements_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@elements"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "description",
              "content": {
                "type": "SYMBOL",
                "name": "tag_description"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "element_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@element"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "description",
              "content": {
                "type": "SYMBOL",
                "name": "tag_description"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "language_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "@language"
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "language"
          }
        }
      ]
    },
    "unknown_tag": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "tag_name"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "description",
              "content": {
                "type": "SYMBOL",
                "name": "tag_description"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "tag_description": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "description_line"
      }
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "language": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "\"[^\"\\n]*\"|[a-zA-Z][a-zA-Z0-9-]*"
        }
      }
    },
    "alias": {
      "type": "PATTERN",
      "value": "[^\\s*]([^\\n*]|\\*[^\\/\\n])*"
    },
    "reference_target": {
      "type": "PATTERN",
      "value": "[^\\s*]\\S*"
    },
    "tag_name": {
      "type": "PATTERN",
      "value": "@[a-zA-Z_][a-zA-Z0-9_-]*"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s+"
    },
    {
      "type": "PATTERN",
      "value": "[ \\t]*\\*[ \\t\\n]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "name"
    },
    {
      "type": "SYMBOL",
      "name": "term"
    },
    {
      "type": "SYMBOL",
      "name": "_attribute_open"
    },
    {
      "type": "SYMBOL",
      "name": "attribute_value"
    },
    {
      "type": "SYMBOL",
      "name": "_property_line"
    },
    {
      "type": "SYMBOL",
      "name": "_colon"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}